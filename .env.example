# ==============================================================================
# NxDesk — Variables de Entorno para Docker y Producción
# ==============================================================================

# Token de autenticación de Ngrok (Gratuito en https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN=tu_authtoken_de_ngrok_aqui

# Dirección y puerto de escucha del servidor de señalización
BIND_ADDR=0.0.0.0:5000

# Nivel de logs (trace, debug, info, warn, error)
RUST_LOG=info
