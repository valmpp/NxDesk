# ==============================================================================
# NxDesk — Plantilla de Configuración de Variables de Entorno (.env.example)
# ==============================================================================

# Dominio público para emisión automática de certificados SSL/TLS con Let's Encrypt (Caddy)
# En local usar: localhost | En producción: nxdesk.tu-dominio.com
NXDESK_DOMAIN=localhost

# Nivel de registro de eventos (trace, debug, info, warn, error)
RUST_LOG=info

# Dirección interna del servidor de señalización para el reverse proxy
SIGNALING_UPSTREAM=nxdesk-server:5000

# Puerto del Web Dashboard del cliente (por defecto 8080)
NXDESK_WEB_PORT=8080
