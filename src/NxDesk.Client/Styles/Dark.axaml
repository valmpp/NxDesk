<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Tema Oscuro - Colores principales -->
    <Color x:Key="ThemePrimaryColor">#007ACC</Color>
    <Color x:Key="ThemeAccentColor">#1C97EA</Color>
    
    <!-- Fondos -->
    <SolidColorBrush x:Key="ThemeBackground" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="ThemeBackgroundSecondary" Color="#252526"/>
    <SolidColorBrush x:Key="ThemeBackgroundTertiary" Color="#2D2D30"/>
    <SolidColorBrush x:Key="ThemeBackgroundDark" Color="#121212"/>
    <SolidColorBrush x:Key="ThemeOverlayBackground" Color="#CC000000"/>
    
    <!-- Superficies -->
    <SolidColorBrush x:Key="ThemeSurface" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="ThemeSurfaceHover" Color="#3E3E42"/>
    <SolidColorBrush x:Key="ThemeSurfaceActive" Color="#505050"/>
    
    <!-- Bordes -->
    <SolidColorBrush x:Key="ThemeBorder" Color="#333333"/>
    <SolidColorBrush x:Key="ThemeBorderLight" Color="#404040"/>
    
    <!-- Texto -->
    <SolidColorBrush x:Key="ThemeText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ThemeTextSecondary" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="ThemeTextMuted" Color="#888888"/>
    <SolidColorBrush x:Key="ThemeTextDisabled" Color="#666666"/>
    
    <!-- Primarios -->
    <SolidColorBrush x:Key="ThemePrimary" Color="#007ACC"/>
    <SolidColorBrush x:Key="ThemePrimaryHover" Color="#1C97EA"/>
    <SolidColorBrush x:Key="ThemePrimaryActive" Color="#005A9E"/>
    <SolidColorBrush x:Key="ThemePrimaryTransparent" Color="#80007ACC"/>
    
    <!-- Estados -->
    <SolidColorBrush x:Key="ThemeSuccess" Color="#00CC66"/>
    <SolidColorBrush x:Key="ThemeError" Color="#D13438"/>
    <SolidColorBrush x:Key="ThemeWarning" Color="#FFD700"/>
    <SolidColorBrush x:Key="ThemeInfo" Color="#17A2B8"/>
    
    <!-- Sombras -->
    <Color x:Key="ThemeShadowColor">#000000</Color>

</ResourceDictionary>
