<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             x:Class="NxDesk.Client.Controls.WindowActionsControl">

        <StackPanel Name="ControlWrapper" Orientation="Horizontal" Spacing="0" HorizontalAlignment="Right" Background="Transparent">
            <StackPanel.Styles>
                <!-- Trigger expansion specifically when THIS StackPanel is hovered -->
                <Style Selector="StackPanel:pointerover Border#ActionsPanel">
                    <Setter Property="Width" Value="100"/>
                    <Setter Property="Opacity" Value="1"/>
                </Style>
                <!-- Base state of the inner panel -->
                <Style Selector="Border#ActionsPanel">
                    <Setter Property="Width" Value="0"/>
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Width" Duration="0:0:0.25" Easing="QuarticEaseOut"/>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                        </Transitions>
                    </Setter>
                </Style>
                <!-- Main button hover effect -->
                <Style Selector="Button.Trigger:pointerover">
                    <Setter Property="Opacity" Value="0.7"/>
                </Style>
            </StackPanel.Styles>

            <!-- Main Trigger Icon (Always visible, serves as the hover target initiator) -->
            <Button Name="MainButton" 
                    Classes="Trigger" 
                    ToolTip.Tip="Opciones de ventana"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8"
                    Margin="0,0,5,0"
                    Cursor="Hand"
                    Focusable="False">
                <Path Data="M12,8c1.1,0,2-0.9,2-2s-0.9-2-2-2s-2,0.9-2,2S10.9,8,12,8z M12,10c-1.1,0-2,0.9-2,2s0.9,2,2,2s2-0.9,2-2S13.1,10,12,10z M12,16c-1.1,0-2,0.9-2,2s0.9,2,2,2s2-0.9,2-2S13.1,16,12,16z"
                      Fill="#555"
                      Stretch="Uniform"
                      IsHitTestVisible="False"
                      Width="16" Height="16"/>
            </Button>

            <!-- Action Panel (Expands on hover) -->
            <Border Name="ActionsPanel"
                    Background="{DynamicResource ThemeBackgroundTertiary}"
                    CornerRadius="16"
                    Padding="5,4"
                    BoxShadow="0 4 15 0 #15000000"
                    ClipToBounds="True">
                <!-- StackPanel width is fixed so icons don't squash during transition -->
                <StackPanel Orientation="Horizontal" Spacing="4" Width="90" HorizontalAlignment="Left">
                    <!-- Minimize -->
                    <Button Classes="ModernIcon" Click="Minimize_Click" ToolTip.Tip="Minimizar" Width="24" Height="24">
                        <Path Data="M 0 5 H 10" Stroke="{DynamicResource ThemeText}" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                    <!-- Maximize -->
                    <Button Classes="ModernIcon" Click="Maximize_Click" ToolTip.Tip="Maximizar" Width="24" Height="24">
                        <Path Data="M 0 0 H 8 V 8 H 0 Z" Stroke="{DynamicResource ThemeText}" StrokeThickness="1.5" Width="9" Height="9" Stretch="Uniform"/>
                    </Button>
                    <!-- Separator -->
                    <Rectangle Width="1" Height="14" Fill="{DynamicResource ThemeBorder}" Opacity="0.5" Margin="2,0"/>
                    <!-- Close -->
                    <Button Classes="ModernIcon" Click="Close_Click" ToolTip.Tip="Cerrar" Width="24" Height="24">
                        <Path Data="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"
                              Fill="{DynamicResource ThemeError}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
</UserControl>
