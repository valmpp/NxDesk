<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NxDesk.Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             x:Class="NxDesk.Client.Controls.ConnectionSpinner"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Styles>
        <!-- Rotation Animation -->
        <Style Selector="Arc.Spinner">
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="Infinite">
                    <KeyFrame KeyTime="0:0:0">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                    </KeyFrame>
                    <KeyFrame KeyTime="0:0:1.5">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Ripple Animation 1 -->
        <Style Selector="Ellipse.Ripple1">
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="Infinite">
                    <KeyFrame KeyTime="0:0:0">
                        <Setter Property="Width" Value="50"/>
                        <Setter Property="Height" Value="50"/>
                        <Setter Property="Opacity" Value="0.6"/>
                    </KeyFrame>
                    <KeyFrame KeyTime="0:0:2">
                        <Setter Property="Width" Value="150"/>
                        <Setter Property="Height" Value="150"/>
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Ripple Animation 2 -->
        <Style Selector="Ellipse.Ripple2">
            <Style.Animations>
                <Animation Duration="0:0:2" Delay="0:0:0.6" IterationCount="Infinite">
                    <KeyFrame KeyTime="0:0:0">
                        <Setter Property="Width" Value="50"/>
                        <Setter Property="Height" Value="50"/>
                        <Setter Property="Opacity" Value="0.6"/>
                    </KeyFrame>
                    <KeyFrame KeyTime="0:0:2">
                        <Setter Property="Width" Value="150"/>
                        <Setter Property="Height" Value="150"/>
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*, Auto" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Panel Grid.Row="0" Width="200" Height="200">
            <!-- Ripples -->
            <Ellipse Classes="Ripple1" Stroke="{DynamicResource ThemePrimary}" StrokeThickness="2" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Ellipse Classes="Ripple2" Stroke="{DynamicResource ThemePrimary}" StrokeThickness="2" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            
            <!-- Static Center -->
            <Ellipse Width="10" Height="10" Fill="{DynamicResource ThemePrimary}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="10" Color="{DynamicResource ThemePrimaryColor}" Opacity="0.8"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- Rotating Spinner Ring -->
            <Arc Classes="Spinner"
                 Width="60" Height="60"
                 StartAngle="0" SweepAngle="270"
                 Stroke="{DynamicResource ThemePrimary}"
                 StrokeThickness="4"
                 StrokeLineCap="Round">
                 <Arc.RenderTransform>
                     <RotateTransform />
                 </Arc.RenderTransform>
            </Arc>
        </Panel>

        <!-- Status Text -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,-40,0,0">
            <TextBlock Text="{Binding StatusMessage}" 
                       Foreground="White" 
                       FontSize="{DynamicResource FontSizeLarge}" 
                       FontWeight="SemiBold" 
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
            
            <TextBlock Text="Estableciendo conexión segura..." 
                       Foreground="{DynamicResource ThemeTextMuted}" 
                       FontSize="{DynamicResource FontSizeSmall}" 
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
