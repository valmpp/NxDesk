<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NxDesk.Client.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:NxDesk.Client.Views"
        xmlns:controls="clr-namespace:NxDesk.Client.Controls"
        xmlns:dto="clr-namespace:NxDesk.Application.DTOs;assembly=NxDesk.Application"
        mc:Ignorable="d" d:DesignWidth="1020" d:DesignHeight="691"
        x:Class="NxDesk.Client.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="NxDesk"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="CenterScreen"
        Width="1020" Height="691"
        MinWidth="1020" MinHeight="691">

    <Window.Resources>
        <controls:BoolToControlTextConverter x:Key="BoolToControlTextConverter"/>
        <controls:RemoteControlBrushConverter x:Key="RemoteControlBrushConverter"/>
        <controls:BoolToControlTextConverter x:Key="AdminModeTextConverter"/> <!-- Reuse or specific label -->
    </Window.Resources>

    <Window.Styles>
    </Window.Styles>

    <Border Name="MainBorder"
            CornerRadius="30"
            Background="{DynamicResource ThemeBackground}"
            Padding="0"
            Margin="10"
            BoxShadow="0 10 30 0 #80000000">

        <Grid Name="MainGrid" RowDefinitions="Auto, *, Auto" ClipToBounds="False">
            <!-- Header / Title Bar -->
            <Border Grid.Row="0" Background="Transparent" Padding="20,10" PointerPressed="OnPointerPressed">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <!-- Logo -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Nx" FontWeight="Bold" Foreground="{DynamicResource ThemePrimary}" FontSize="{DynamicResource FontSizeLarge}"/>
                        <TextBlock Text="Desk" FontWeight="Light" Foreground="{DynamicResource ThemeText}" FontSize="{DynamicResource FontSizeLarge}"/>
                    </StackPanel>

                    <!-- Center Controls (Changes based on session state) -->
                    <Panel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="False">
                        <!-- Pre-Session: Connection Box -->
                        <StackPanel x:Name="PreSessionControls" Orientation="Horizontal" IsVisible="{Binding !IsSessionActive}">
                            <TextBlock Text="ID de Sala:" Foreground="{DynamicResource ThemeTextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <Panel VerticalAlignment="Center">
                                <TextBox Width="280"
                                         x:Name="RoomIdTextBox"
                                         Classes="Modern"
                                         Watermark="Ingrese ID..."
                                         VerticalContentAlignment="Center"
                                         MaxLength="16"
                                         Padding="10,8,40,8"
                                         Text="{Binding TargetId}"
                                         TextInput="OnRoomIdTextInput"
                                         CopyingToClipboard="OnRoomIdCopying"
                                         PastingFromClipboard="OnRoomIdPasting"
                                         CuttingToClipboard="OnRoomIdCutting"
                                         KeyDown="OnRoomIdKeyDown"/>
                                <Button HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Width="32" Height="32"
                                        Margin="0,0,3,0"
                                        Classes="ModernIcon"
                                        ToolTip.Tip="Conectar"
                                        Command="{Binding ConnectByIdCommand}">
                                    <Path Data="M12,4l-1.41,1.41L16.17,11H4v2h12.17l-5.58,5.59L12,20l8-8L12,4z"
                                          Fill="{DynamicResource ThemePrimary}"
                                          Stretch="Uniform"
                                          Width="16" Height="16"/>
                                </Button>
                            </Panel>
                        </StackPanel>

                        <!-- In-Session: Call Controls -->
                        <Border IsVisible="{Binding IsSessionActive}"
                                Background="{DynamicResource ThemeBackgroundSecondary}"
                                CornerRadius="18"
                                Padding="4,4"
                                BoxShadow="0 8 30 0 #0C000000"
                                Margin="0,0,0,20"
                                ClipToBounds="False"
                                ZIndex="100"
                                Opacity="0.99">
                            <StackPanel x:Name="InSessionControls" Orientation="Horizontal" Spacing="2">
                                <!-- Remote Control Toggle Button -->
                                <Button Command="{Binding ToggleRemoteControlCommand}"
                                        Classes="ModernIcon" 
                                        IsVisible="{Binding IsAdmin}"
                                        ToolTip.Tip="{Binding IsRemoteControlEnabled, Converter={StaticResource BoolToControlTextConverter}}"
                                        Foreground="{Binding IsRemoteControlEnabled, Converter={StaticResource RemoteControlBrushConverter}}">
                                    <Path Width="16" Height="16" Stretch="Uniform" 
                                          Fill="{Binding $parent[Button].Foreground}"
                                          Data="M12,17C10.89,17 10,16.1 10,15C10,13.89 10.89,13 12,13A2,2 0 0,1 14,15A2,2 0 0,1 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.89,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z" />
                                </Button>

                                <!-- Screen Lock Toggle Button (admin only) -->
                                <Button Command="{Binding ToggleScreenLockCommand}"
                                        Classes="ModernIcon" 
                                        IsVisible="{Binding IsAdmin}"
                                        ToolTip.Tip="Bloquear/Desbloquear pantalla del Host"
                                        Foreground="{Binding IsScreenLocked, Converter={StaticResource RemoteControlBrushConverter}}">
                                    <Path Width="16" Height="16" Stretch="Uniform" 
                                          Fill="{Binding $parent[Button].Foreground}"
                                          Data="M21,21H3V3H21V21M19,13H13V19H19V13M11,19V13H5V19H11M19,5H13V11H19V5M11,11V5H5V11H11Z" />
                                </Button>

                                <!-- Recording Button -->
                                <Button Classes="ModernIcon" ToolTip.Tip="Grabar Sesión"
                                        Command="{Binding ToggleRecordingCommand}">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover">
                                            <Setter Property="RenderTransform" Value="scale(1.1)"/>
                                        </Style>
                                    </Button.Styles>
                                    <Panel>
                                        <Ellipse Width="16" Height="16" Fill="#FF4444" IsVisible="{Binding !IsRecording}"/>
                                        <Rectangle Width="14" Height="14" Fill="#FF4444" IsVisible="{Binding IsRecording}"/>
                                    </Panel>
                                </Button>

                                <!-- Separator -->
                                <Border Width="1" Height="20" Background="{DynamicResource ThemeBorder}" Opacity="0.3" Margin="4,0"/>

                                <!-- File Transfer Button (admin only) -->
                                <Button Classes="ModernIcon" ToolTip.Tip="Transferir Archivos"
                                        IsVisible="{Binding IsAdmin}">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Header="Enviar Archivo..." Command="{Binding SendFileCommand}">
                                                <MenuItem.Icon>
                                                    <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource ThemeText}"
                                                          Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Enviar Carpeta..." Command="{Binding SendFolderCommand}">
                                                <MenuItem.Icon>
                                                    <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource ThemeText}"
                                                          Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                    <Path Width="16" Height="16" Stretch="Uniform" 
                                          Fill="{DynamicResource ThemePrimary}"
                                          Data="M16 13H13.5V17H10.5V13H8L12 8L16 13M8 11H10.5V7H13.5V11H16L12 16L8 11Z" />
                                </Button>

                                <!-- Separator -->
                                <Border Width="1" Height="20" Background="{DynamicResource ThemeBorder}" Opacity="0.3" Margin="4,0"/>

                                <!-- Disconnect Button (Expandable Logout) -->
                                <Button Command="{Binding DisconnectCommand}"
                                        Classes="ModernIcon"
                                        Width="NaN"
                                        MinWidth="34"
                                        Height="34"
                                        Padding="8,0"
                                        Foreground="{DynamicResource ThemeError}"
                                        Background="Transparent"
                                        Focusable="False"
                                        Cursor="Hand"
                                        ToolTip.Tip="Finalizar sesión">
                                    <Button.Transitions>
                                        <Transitions>
                                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                                        </Transitions>
                                    </Button.Transitions>
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover">
                                            <Setter Property="Background" Value="#10D13438"/>
                                        </Style>
                                        <!-- Primary expansion trigger -->
                                        <Style Selector="Button:pointerover Border#PART_Label">
                                            <Setter Property="Width" Value="85"/>
                                            <Setter Property="Opacity" Value="1"/>
                                        </Style>
                                        <!-- Robust collapse: ensure it returns to 0 even if pointer events are messy -->
                                        <Style Selector="Border#PART_Label">
                                            <Setter Property="Width" Value="0"/>
                                            <Setter Property="Opacity" Value="0"/>
                                            <Setter Property="Transitions">
                                                <Transitions>
                                                    <DoubleTransition Property="Width" Duration="0:0:0.25" Easing="QuarticEaseOut"/>
                                                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                                </Transitions>
                                            </Setter>
                                        </Style>
                                        <Style Selector="Button:pressed">
                                            <Setter Property="RenderTransform" Value="scale(0.95)"/>
                                        </Style>
                                    </Button.Styles>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M19,3H5C3.89,3 3,3.89 3,5V9H5V5H19V19H5V15H3V19C3,20.11 3.89,21 5,21H19C20.11,21 21,20.11 21,19V5C21,3.89 20.11,3 19,3M10.08,15.58L11.5,17L16.5,12L11.5,7L10.08,8.41L12.67,11H3V13H12.67L10.08,15.58Z"
                                              Fill="{Binding $parent[Button].Foreground}"
                                              Stretch="Uniform"
                                              Width="16" Height="16"
                                              IsHitTestVisible="False"
                                              VerticalAlignment="Center"/>
                                        <Border Name="PART_Label" ClipToBounds="True" IsHitTestVisible="False">
                                            <TextBlock Text="Desconectar" 
                                                       Margin="10,0,5,0"
                                                       FontSize="12" 
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Panel>

                    <!-- Right Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
                        <!-- Admin Toggle -->
                        <Button Classes="ModernIcon" 
                                ToolTip.Tip="{Binding IsAdmin, ConverterParameter='Dejar de ser Admin', Converter={StaticResource BoolToControlTextConverter}, FallbackValue='Acceso Admin'}" 
                                Command="{Binding ToggleAdminModeCommand}"
                                Foreground="{Binding IsAdmin, Converter={StaticResource RemoteControlBrushConverter}}">
                            <Path Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,5A3,3 0 0,1 15,8V10H16A2,2 0 0,1 18,12V17A2,2 0 0,1 16,19H8A2,2 0 0,1 6,17V12A2,2 0 0,1 8,10H9V8A3,3 0 0,1 12,5M12,7A1,1 0 0,0 11,8V10H13V8A1,1 0 0,0 12,7Z"
                                  Fill="{Binding $parent[Button].Foreground}"
                                  Stretch="Uniform"
                                  Width="18" Height="18"/>
                        </Button>

                        <!-- Settings -->
                        <Button Classes="ModernIcon" ToolTip.Tip="Configuración" Click="OnSettingsClick">
                            <TextBlock Text="⚙" FontSize="{DynamicResource FontSizeLarge}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>



                        <!-- Screen Menu -->
                        <Button Name="MenuButton" Classes="ModernIcon" ToolTip.Tip="Pantallas" IsVisible="{Binding IsSessionActive}">
                            <Button.Flyout>
                                <MenuFlyout ItemsSource="{Binding RemoteScreens}">
                                    <MenuFlyout.ItemContainerTheme>
                                        <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="dto:ScreenInfoDto">
                                            <Setter Property="Header" Value="{Binding Name}"/>
                                            <Setter Property="Command" Value="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectRemoteScreenCommand}"/>
                                            <Setter Property="CommandParameter" Value="{Binding}"/>
                                            <Setter Property="Icon">
                                                <Template>
                                                    <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z" 
                                                          Fill="{DynamicResource ThemePrimary}"
                                                          Width="14" Height="14" Stretch="Uniform">
                                                        <Path.IsVisible>
                                                            <MultiBinding Converter="{StaticResource ScreenSelectionConverter}">
                                                                <Binding Path="."/>
                                                                <Binding Path="$parent[Window].((vm:MainWindowViewModel)DataContext).CurrentRemoteScreen"/>
                                                            </MultiBinding>
                                                        </Path.IsVisible>
                                                    </Path>
                                                </Template>
                                            </Setter>
                                        </ControlTheme>
                                    </MenuFlyout.ItemContainerTheme>
                                </MenuFlyout>
                            </Button.Flyout>
                            <Path Data="M21,16H3V4H21M21,2H3C1.89,2 1,2.89 1,4V16A2,2 0 0,0 3,18H10V20H8V22H16V20H14V18H21A2,2 0 0,0 23,16V4C23,2.89 22.1,2 21,2Z"
                                  Fill="{Binding $parent[Button].Foreground}"
                                  Stretch="Uniform"
                                  Width="18" Height="18"/>
                        </Button>

                        <!-- Window Actions -->
                        <controls:WindowActionsControl Margin="5,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Border Grid.Row="1" Background="{DynamicResource ThemeBackgroundDark}" ClipToBounds="True">
                <Panel>
                    <views:HomeView IsVisible="{Binding !IsSessionActive}"/>
                    <views:RemoteView IsVisible="{Binding IsSessionActive}"/>
                    
                    <!-- Loading Overlay -->
                    <Border Background="#AA000000" IsVisible="{Binding IsConnecting}">
                        <controls:ConnectionSpinner HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Toast Container -->
                    <ItemsControl ItemsSource="{Binding Notifications}" 
                                  VerticalAlignment="Top" HorizontalAlignment="Right" 
                                  Margin="0,20,20,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:ToastControl/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Connection Type Dialog Overlay -->
                    <controls:ConnectionTypeDialog IsVisible="{Binding IsConnectionDialogVisible}"/>

                    <!-- Remote File Explorer Overlay -->
                    <Border Background="#CC000000" IsVisible="{Binding IsRemoteExplorerVisible}" Padding="40" CornerRadius="30">
                        <Border Background="{DynamicResource ThemeBackground}" 
                                CornerRadius="20" 
                                BoxShadow="0 10 30 0 #A0000000" 
                                MaxWidth="600" 
                                VerticalAlignment="Center" 
                                HorizontalAlignment="Stretch">
                            <Grid RowDefinitions="Auto, *, Auto" Height="500">
                                <!-- Header -->
                                <Border Grid.Row="0" Background="{DynamicResource ThemeBackgroundSecondary}" CornerRadius="20,20,0,0" Padding="20,15">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <Button Command="{Binding NavigateRemoteCommand}" 
                                                CommandParameter="{x:Null}"
                                                Padding="8" 
                                                Background="Transparent"
                                                ToolTip.Tip="Subir de nivel">
                                            <Path Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" 
                                                  Fill="{DynamicResource ThemeText}" 
                                                  Width="18" Height="18" Stretch="Uniform"/>
                                        </Button>
                                        <TextBlock Grid.Column="1" Text="{Binding CurrentRemotePath}" 
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" 
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" 
                                                   Margin="15,0" FontSize="14"/>
                                        <Button Grid.Column="2" Command="{Binding CloseRemoteExplorerCommand}" 
                                                Padding="8" Background="Transparent">
                                            <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" 
                                                  Fill="{DynamicResource ThemeText}" 
                                                  Width="18" Height="18" Stretch="Uniform"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                
                                <!-- Content -->
                                <Panel Grid.Row="1">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding RemoteItems}" Padding="15">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateRemoteCommand}" 
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" 
                                                            HorizontalAlignment="Stretch" 
                                                            HorizontalContentAlignment="Left" 
                                                            Padding="12,8"
                                                            Margin="0,2"
                                                            CornerRadius="8"
                                                            Cursor="Hand">
                                                        <Button.Styles>
                                                            <Style Selector="Button:pointerover">
                                                                <Setter Property="Background" Value="{DynamicResource ThemeBackgroundSecondary}"/>
                                                            </Style>
                                                        </Button.Styles>
                                                        <Grid ColumnDefinitions="Auto, *" VerticalAlignment="Center">
                                                            <Panel Width="22" Height="22" Margin="0,0,15,0" VerticalAlignment="Center">
                                                                <!-- Folder Icon -->
                                                                <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z" 
                                                                      Fill="{DynamicResource ThemePrimary}" 
                                                                      IsVisible="{Binding IsDirectory}" 
                                                                      Stretch="Uniform"/>
                                                                <!-- File Icon -->
                                                                <Path Data="M13,9H18.5L13,3.5V9M6,2H14L20,8V20A2,2 0 0,1 18,22H6C4.89,22 4,21.1 4,20V4C4,2.89 4.89,2 6,2Z" 
                                                                      Fill="{DynamicResource ThemeTextSecondary}" 
                                                                      IsVisible="{Binding !IsDirectory}" 
                                                                      Stretch="Uniform"/>
                                                            </Panel>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" 
                                                                       VerticalAlignment="Center" FontSize="14"/>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    
                                    <ProgressBar IsIndeterminate="True" 
                                                 VerticalAlignment="Top" 
                                                 Height="2" 
                                                 Background="Transparent"
                                                 Foreground="{DynamicResource ThemePrimary}"
                                                 IsVisible="{Binding IsRemoteExplorerLoading}"/>
                                </Panel>

                                <!-- Footer -->
                                <Border Grid.Row="2" Padding="20,15" Background="{DynamicResource ThemeBackgroundSecondary}" CornerRadius="0,0,20,20">
                                    <Grid ColumnDefinitions="*, Auto, Auto">
                                        <TextBlock Text="Selecciona una carpeta de destino" 
                                                   VerticalAlignment="Center" 
                                                   Foreground="{DynamicResource ThemeTextSecondary}" 
                                                   FontSize="12" FontStyle="Italic"/>
                                        <Button Grid.Column="1" Content="Cancelar" 
                                                Command="{Binding CloseRemoteExplorerCommand}" 
                                                Margin="0,0,10,0"
                                                Padding="15,8"
                                                CornerRadius="8"
                                                Background="Transparent"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource ThemeBorder}"/>
                                        <Button Grid.Column="2" Content="Confirmar Destino" 
                                                Command="{Binding ConfirmRemoteTargetCommand}" 
                                                Padding="20,8"
                                                CornerRadius="8"
                                                Background="{DynamicResource ThemePrimary}"
                                                Foreground="White"
                                                FontWeight="SemiBold"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Border>
                </Panel>
            </Border>

            <!-- Admin Password Overlay -->
            <Border Grid.Row="0" Grid.RowSpan="3" 
                    Background="#80000000" 
                    IsVisible="{Binding IsAdminPasswordDialogVisible}" 
                    ZIndex="1000">
                <Border Background="{DynamicResource ThemeBackground}" 
                        CornerRadius="20" 
                        Width="350" 
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Center"
                        Padding="30"
                        BoxShadow="0 10 40 0 #40000000">
                    <StackPanel Spacing="20">
                        <TextBlock Text="Acceso Administrativo" 
                                   FontSize="20" FontWeight="Bold" 
                                   HorizontalAlignment="Center"/>
                        
                        <TextBlock Text="Ingrese la contraseña para activar el modo administrador." 
                                   FontSize="13" Foreground="{DynamicResource ThemeTextSecondary}"
                                   TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>

                        <Panel>
                            <TextBox Classes="Modern" 
                                     PasswordChar="*" 
                                     Watermark="Contraseña" 
                                     Text="{Binding AdminPassword}"
                                     FontSize="16"
                                     HorizontalContentAlignment="Center"/>
                        </Panel>

                        <TextBlock Text="{Binding AdminPasswordError}" 
                                   Foreground="{DynamicResource ThemeError}" 
                                   FontSize="12" 
                                   HorizontalAlignment="Center"
                                   IsVisible="{Binding !!AdminPasswordError}"/>

                        <Grid ColumnDefinitions="*, * " ColumnSpacing="10">
                            <Button Grid.Column="0" Content="Cancelar" 
                                    Command="{Binding CancelAdminPasswordCommand}" 
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Classes="Secondary"/>
                            <Button Grid.Column="1" Content="Listo" 
                                    Command="{Binding ConfirmAdminPasswordCommand}" 
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Classes="Primary"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Admin Leave Confirmation Overlay -->
            <Border Grid.Row="0" Grid.RowSpan="3" 
                    Background="#80000000" 
                    IsVisible="{Binding IsAdminLeaveConfirmationVisible}" 
                    ZIndex="1000">
                <Border Background="{DynamicResource ThemeBackground}" 
                        CornerRadius="20" 
                        Width="350" 
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Center"
                        Padding="30"
                        BoxShadow="0 10 40 0 #40000000">
                    <StackPanel Spacing="20">
                        <TextBlock Text="Cerrar Sesión Admin" 
                                   FontSize="20" FontWeight="Bold" 
                                   HorizontalAlignment="Center"/>
                        
                        <TextBlock Text="¿Desea dejar de ser administrador y volver a la vista normal?" 
                                   FontSize="13" Foreground="{DynamicResource ThemeTextSecondary}"
                                   TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>

                        <Grid ColumnDefinitions="*, * " ColumnSpacing="10">
                            <Button Grid.Column="0" Content="No, seguir" 
                                    Command="{Binding CancelLeaveAdminModeCommand}" 
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Classes="Secondary"/>
                            <Button Grid.Column="1" Content="Sí, salir" 
                                    Command="{Binding LeaveAdminModeCommand}" 
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Classes="Primary"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Status Bar -->
            <Border Grid.Row="2" Background="{DynamicResource ThemeBackgroundSecondary}" Padding="20,10,20,12" Opacity="0.6">
                <Grid ColumnDefinitions="*, Auto">
                    <!-- Connection Status -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Background="{DynamicResource ThemeSuccess}" 
                                Width="8" Height="8" 
                                CornerRadius="4" 
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsSessionActive}"/>
                        <TextBlock Text="{Binding StatusText}" 
                                   Foreground="{DynamicResource ThemeText}" 
                                   FontSize="13"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Performance Indicators -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" IsVisible="{Binding IsSessionActive}">
                        <!-- Session Time -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"
                                  Fill="{DynamicResource ThemeTextMuted}"
                                  Stretch="Uniform"
                                  Width="14" Height="14"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ConnectionDuration}" 
                                       Foreground="{DynamicResource ThemeText}" 
                                       FontSize="12"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Latency -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="M7,10L12,15L17,10H7Z"
                                  Fill="{DynamicResource ThemeSuccess}"
                                  Stretch="Uniform"
                                  Width="14" Height="14"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LatencyText}" 
                                       Foreground="{DynamicResource ThemeSuccess}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- FPS -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="FPS" 
                                       Foreground="{DynamicResource ThemeTextMuted}" 
                                       FontSize="11"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentFps, StringFormat={}{0:F0}}" 
                                       Foreground="{DynamicResource ThemeSuccess}" 
                                       FontSize="12"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Recording Indicator -->
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    IsVisible="{Binding IsRecording}">
                            <Ellipse Width="10" Height="10" Fill="#FF4444" VerticalAlignment="Center"/>
                            <TextBlock Text="REC" 
                                       Foreground="#FF4444" 
                                       FontSize="11"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding RecordingDuration}" 
                                       Foreground="#FF4444" 
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
