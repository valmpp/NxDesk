<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NxDesk.Client.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="600"
             x:Class="NxDesk.Client.Views.HomeView"
             x:DataType="vm:MainWindowViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Background="{DynamicResource ThemeBackground}">

            <!-- My Workstation ID Section -->
            <Border Padding="0,30,0,30" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Este puesto de trabajo"
                               Foreground="{DynamicResource ThemeTextSecondary}"
                               FontSize="{DynamicResource FontSizeLarge}"
                               HorizontalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center" 
                                Margin="0,5,0,0">
<TextBlock Text="{Binding MyId}"
           Foreground="{DynamicResource ThemePrimary}" FontSize="{DynamicResource FontSizeTitle}"
           FontWeight="Bold"
           VerticalAlignment="Center"/>

                        <Button Margin="15,5,0,0"
                                Classes="ModernIcon"
                                ToolTip.Tip="Copiar ID"
                                Click="CopyId_Click"
                                VerticalAlignment="Center">
                            <Path Data="M16,1H4C2.9,1,2,1.9,2,3v14h2V3h12V1zm3,4H8C6.9,5,6,5.9,6,7v14c0,1.1,0.9,2,2,2h11c1.1,0,2-0.9,2-2V7c0-1.1-0.9-2-2-2zm0,16H8V7h11v14z"
                                  Fill="{Binding $parent[Button].Foreground}"
                                  Stretch="Uniform"
                                  Width="20" Height="20"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Discovered Section -->
            <TextBlock Text="Descubierto"
                       Foreground="{DynamicResource ThemeText}"
                       FontSize="{DynamicResource FontSizeLarge}"
                       FontWeight="SemiBold"
                       Margin="30,20,0,0"/>

            <ItemsControl ItemsSource="{Binding DiscoveredPeers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Margin="20" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="DeviceCard" Margin="10">
                            <Panel>
                                <!-- Lock Icon (Top-Right) — Opens connection type dialog -->
                                <Button Classes="ModernIcon"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,8,8,0"
                                        ToolTip.Tip="Conectar a este equipo"
                                        Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ShowConnectionDialogCommand}"
                                        CommandParameter="{Binding}">
                                    <Path Data="M12,17C10.89,17 10,16.1 10,15C10,13.89 10.89,13 12,13A2,2 0 0,1 14,15A2,2 0 0,1 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.89,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z"
                                          Fill="{DynamicResource ThemePrimary}"
                                          Stretch="Uniform"
                                          Width="18" Height="18"/>
                                </Button>

                                <StackPanel VerticalAlignment="Bottom" Margin="12">
                                    <TextBlock Text="{Binding Alias}" 
                                               Foreground="{DynamicResource ThemeText}" 
                                               FontSize="{DynamicResource FontSizeLarge}" 
                                               FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Id}" 
                                               Foreground="{DynamicResource ThemeTextSecondary}" 
                                               FontSize="{DynamicResource AppFontSize}"/>
                                    <TextBlock Text="{Binding IpAddress}" 
                                               Foreground="{DynamicResource ThemeTextSecondary}" 
                                               FontSize="{DynamicResource AppFontSize}"
                                               IsVisible="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).IsAdmin}"/>
                                </StackPanel>
                            </Panel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
