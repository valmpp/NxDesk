<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Navigation -->
    <x:String x:Key="S_Settings_Title">AJUSTES</x:String>
    <x:String x:Key="S_Settings_Preferences">Preferencias</x:String>
    <x:String x:Key="S_Settings_Appearance">Apariencia</x:String>
    <x:String x:Key="S_Settings_Session">Sesión</x:String>
    <x:String x:Key="S_Settings_Security">Seguridad</x:String>
    <x:String x:Key="S_Settings_Close">Cerrar ventana</x:String>

    <!-- Appearance -->
    <x:String x:Key="S_Settings_Apperance_Desc">Personaliza el aspecto de tu aplicación</x:String>
    <x:String x:Key="S_Settings_ThemeDark">Tema Oscuro</x:String>
    <x:String x:Key="S_Settings_ThemeDesc">Cambia entre modo claro y oscuro</x:String>
    <x:String x:Key="S_Settings_Language">Idioma</x:String>
    <x:String x:Key="S_Settings_LanguageDesc">Selecciona tu idioma preferido</x:String>
    <x:String x:Key="S_Settings_FontSize">Tamaño de fuente</x:String>
    <x:String x:Key="S_Settings_FontSizeDesc">Ajusta la legibilidad del texto</x:String>

    <!-- Session -->
    <x:String x:Key="S_Settings_Session_Desc">Historial y conexiones recientes</x:String>
    <x:String x:Key="S_Settings_History">Historial de conexiones</x:String>
    <x:String x:Key="S_Settings_Clear">Limpiar</x:String>
    <x:String x:Key="S_Settings_Today">Hoy</x:String>
    <x:String x:Key="S_Settings_Yesterday">Ayer</x:String>

    <!-- Security -->
    <x:String x:Key="S_Settings_Security_Desc">Control de acceso y privacidad</x:String>
    <x:String x:Key="S_Settings_Password">Contraseña de Acceso</x:String>
    <x:String x:Key="S_Settings_Password_Desc">Permite la conexión automática sin aprobación manual si se conoce esta contraseña.</x:String>
    <x:String x:Key="S_Settings_Password_Watermark">Ingresa nueva contraseña...</x:String>
    <x:String x:Key="S_Settings_Save">Guardar</x:String>
    <x:String x:Key="S_Settings_Confirmation">Confirmación de conexión</x:String>
    <x:String x:Key="S_Settings_AlwaysAsk">Solicitar permiso siempre</x:String>
</ResourceDictionary>
